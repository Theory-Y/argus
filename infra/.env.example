# ── TheoryY service environment ─────────────────────────────────────────────
# Copy to .env at the repo root (the server reads .env via pydantic-settings).

# Business-model switch: "license" (self-host / source-sale) or "saas" (hosted).
AUTH_MODE=license

# ── Memo generation (required in both modes) ────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_EFFORT=high
ANTHROPIC_MAX_TOKENS=16000

# ── Engine data sources ─────────────────────────────────────────────────────
FRED_API_KEY=
SEC_USER_AGENT=TheoryY/1.0 you@example.com

# ── Persistence + storage ───────────────────────────────────────────────────
DATABASE_URL=sqlite:///./theoryy_service.db
STORAGE_BACKEND=local            # local | s3
STORAGE_DIR=output/service
# S3 (when STORAGE_BACKEND=s3):
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_PREFIX=memos
# SIGNED_URL_TTL=86400

# ── License mode ─────────────────────────────────────────────────────────────
# Empty = open self-host. Set a secret to require signed license tokens from clients.
LICENSE_SECRET=

# ── SaaS mode (ignored when AUTH_MODE=license) ──────────────────────────────
JWT_SECRET=change-me-in-production
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
QUEUE_BACKEND=inprocess          # inprocess | rq
REDIS_URL=redis://localhost:6379/0

# ── Web client origin (CORS) ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
