# TheoryY API server image. Contains the PROPRIETARY core + engine + server.
# Ship this only in source-sale deals or run it on your own infra for SaaS.
# Never publish it to the client's environment.
FROM python:3.12-slim

# Runtime deps for PDF/DOCX rendering (core.render → pandoc + headless chromium).
RUN apt-get update && apt-get install -y --no-install-recommends \
        pandoc \
        chromium \
    && rm -rf /var/lib/apt/lists/*

ENV CHROMIUM_BIN=/usr/bin/chromium \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Install engine deps (repo root) + server deps.
COPY requirements.txt ./requirements.txt
COPY server/requirements.txt ./server/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt -r server/requirements.txt

# Proprietary code: engine, core façade, scripts, server, theme assets.
COPY src ./src
COPY core ./core
COPY scripts ./scripts
COPY server ./server
COPY output/theme ./output/theme

EXPOSE 8000
CMD ["uvicorn", "server.app:app", "--host", "0.0.0.0", "--port", "8000"]
