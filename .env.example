# ──────────────────────────────────────────────────────────────────────────────
# TheoryY Argus — Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Anthropic API key — used by both the MCP server and the FastAPI server.
ANTHROPIC_API_KEY=sk-ant-...

# Massive API key — financial market data MCP server (equities, options, crypto, FX).
# Get your key at https://massive.ai
MASSIVE_API_KEY=your_massive_api_key_here

# FRED API key — macro data (commercial construction, etc.).
# Free tier at https://fred.stlouisfed.org/docs/api/api_key.html
# If unset, FRED-backed data sections will be marked unavailable.
FRED_API_KEY=your_fred_api_key_here

# SEC EDGAR user agent — required by EDGAR's fair-use policy (returns 403 if absent).
# Format: "YourName your@email.com" or "YourApp/1.0 contact@example.com"
SEC_USER_AGENT=YourName your@email.com

# ── Optional: Apify job-market signal ─────────────────────────────────────────
# Leave blank to skip job-listing data. Set both to activate.
APIFY_API_KEY=
APIFY_ACTOR_ID=

# ── Optional: ScrapeGraphAI web research (news bodies + niche forums) ──────────
# By default reuses ANTHROPIC_API_KEY above. Alternatively, set GROQ_API_KEY
# (free tier at console.groq.com) and override the model to use Groq instead —
# no Anthropic key required for web research in that case.
# Requires `pip install scrapegraphai markdownify`; if absent the signal falls
# back to lexical-only mode and the pipeline continues fine.
WEB_RESEARCH_ENABLED=true
WEB_RESEARCH_MAX_URLS=5
# Anthropic (default):
# WEB_RESEARCH_MODEL=anthropic/claude-haiku-4-5
# Groq free tier (no Anthropic key needed; requires `pip install langchain-groq`):
# WEB_RESEARCH_MODEL=groq/llama-3.1-8b-instant
# GROQ_API_KEY=gsk_...
# Cap the page text sent to the extractor — full bodies 413 small/free tiers
# (Groq's 6k tokens/min). ~4 chars/token, so 12000 ≈ 3k input tokens.
# WEB_RESEARCH_MAX_INPUT_CHARS=12000
# Require scraped news to name the issuer (ticker/company in headline or sentence),
# so multi-stock roundups don't inject off-target movers. Set false to keep all text.
# WEB_RESEARCH_REQUIRE_TICKER=true

# ── Optional: PDF export ──────────────────────────────────────────────────────
# Path to a Chromium/Chrome binary for headless PDF rendering (scripts/export_pdf.py).
# Auto-detected from PATH if left blank; only needed if auto-detection fails.
CHROMIUM_BIN=
# CHROME_BIN=    # alternative name, same purpose

# ── Server: auth mode ─────────────────────────────────────────────────────────
# "license" = self-hosted (the only mode).
AUTH_MODE=license

# ── Server: persistence ───────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./theoryy_service.db

# ── Server: Anthropic model overrides (optional) ──────────────────────────────
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=6000

# ── Server: storage ───────────────────────────────────────────────────────────
STORAGE_BACKEND=local        # "local" or "s3"
STORAGE_DIR=output/service
# S3_BUCKET=
# S3_REGION=us-east-1        # use "auto" for Cloudflare R2
# S3_PREFIX=memos
# SIGNED_URL_TTL=86400
# S3-compatible stores (Cloudflare R2, MinIO) — set endpoint + keys:
# S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Server: background queue ──────────────────────────────────────────────────
QUEUE_BACKEND=inprocess      # "inprocess" or "rq"
# REDIS_URL=redis://localhost:6379/0

# ── Server: license mode (AUTH_MODE=license) ──────────────────────────────────
# Leave blank for open self-hosted. Set to a secret string to require signed tokens.
# Cloudflare gateway deployment: set this, mint a token for the Worker, and Argus
# will trust the Worker's X-User-Id header to scope jobs per end user. See
# infra/cloudflare/README.md. Cloudflare owns identity/billing — keep AUTH_MODE=license.
LICENSE_SECRET=

# ── Server: CORS ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
